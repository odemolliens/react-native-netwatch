{
  "compilerOptions": {
    "baseUrl": ".",
    "esModuleInterop": true,
    "jsx": "react-native",
    "lib": ["ESNext"],
    "module": "CommonJS",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@dr.pogodin/react-native-fs": ["./node_modules/@dr.pogodin/react-native-fs"],
      "@react-native-clipboard/clipboard": ["./node_modules/@react-native-clipboard/clipboard"],
      "@react-native-community/netinfo": ["./node_modules/@react-native-community/netinfo"],
      "@react-native-vector-icons/*": ["./node_modules/@react-native-vector-icons/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-native": ["./node_modules/react-native"],
      "react-native/*": ["./node_modules/react-native/*"],
      "react-native-json-tree": ["./node_modules/react-native-json-tree"],
      "react-native-netwatch": ["../src"],
      "react-native-paper": ["./node_modules/react-native-paper"],
      "react-native-share": ["./node_modules/react-native-share"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext"
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
